---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section class="relative min-h-[92vh] lg:min-h-screen flex items-center pt-24 pb-16 overflow-hidden">
  
  {/* Full-bleed Architectural Hero Image with Crystal Clear Invisible Grill Effect */}
  <div class="absolute inset-0 z-0">
    <img 
      src={location.heroImage} 
      alt={location.heroImageAlt}
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    {/* Dark subtle architectural vignette overlays */}
    <div class="absolute inset-0 bg-gradient-to-r from-[#0B0D0C]/90 via-[#0B0D0C]/60 to-[#0B0D0C]/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0B0D0C] via-transparent to-[#0B0D0C]/50"></div>

  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8">
    <div class="max-w-3xl mx-auto">
      
      {/* Hero Heading, Subtitle & Action */}
      <div class="space-y-6 text-center lg:text-left">
        
        {/* Location Badge */}
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#121816]/90 border border-[#7CFF3A]/50 backdrop-blur-md shadow-[0_0_20px_rgba(124,255,58,0.2)]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#7CFF3A] animate-ping"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-[#7CFF3A]">
            {location.badge}
          </span>
        </div>

        {/* Big Bold Headline matching Reference Image */}
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
          {location.heroHeadline.includes(' IN ') ? (
            <>
              {location.heroHeadline.split(' IN ')[0]} <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#7CFF3A] via-[#A6FF7A] to-white">
                IN {location.name.toUpperCase()}
              </span>
            </>
          ) : (
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#7CFF3A] via-[#A6FF7A] to-white">
              {location.heroHeadline}
            </span>
          )}
        </h1>

        {/* Emotion Hook Banner */}
        {location.emotionHook && (
          <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-xl bg-[#151C19]/90 border border-[#7CFF3A]/35 backdrop-blur-md text-left shadow-lg">
            <span class="text-[#7CFF3A]">✨</span>
            <p class="text-xs sm:text-sm font-semibold text-[#7CFF3A] italic">
              "{location.emotionHook}"
            </p>
          </div>
        )}

        {/* Subtitle */}
        <p class="text-base sm:text-xl text-[#E2E8F0] font-normal leading-relaxed max-w-xl mx-auto lg:mx-0">
          {location.heroSubhead}
        </p>

        {/* Big Pill CTA Button (Matching Reference Mockup) */}
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a 
            href="#book-visit" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full text-sm sm:text-base font-extrabold text-[#0B0D0C] bg-[#7CFF3A] hover:bg-[#8FFF52] transition-all duration-200 shadow-[0_0_30px_rgba(124,255,58,0.35)] hover:shadow-[0_0_40px_rgba(124,255,58,0.5)] hover:-translate-y-0.5 active:translate-y-0"
          >
            <span>SCHEDULE A FREE MEASUREMENT VISIT IN {location.name.toUpperCase()}</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        {/* Trust metrics bar */}
        <div class="grid grid-cols-3 gap-3 pt-6 border-t border-[#24322B]/80 max-w-lg mx-auto lg:mx-0">
          <div class="bg-[#121816]/80 backdrop-blur-md p-3 rounded-xl border border-[#24322B] text-center">
            <span class="block text-[10px] text-[#94A3B8] uppercase font-bold">Grade</span>
            <span class="text-xs sm:text-sm font-extrabold text-[#7CFF3A]">SS-316 Marine</span>
          </div>
          <div class="bg-[#121816]/80 backdrop-blur-md p-3 rounded-xl border border-[#24322B] text-center">
            <span class="block text-[10px] text-[#94A3B8] uppercase font-bold">Visibility</span>
            <span class="text-xs sm:text-sm font-extrabold text-white">99% Unblocked</span>
          </div>
          <div class="bg-[#121816]/80 backdrop-blur-md p-3 rounded-xl border border-[#24322B] text-center">
            <span class="block text-[10px] text-[#94A3B8] uppercase font-bold">Warranty</span>
            <span class="text-xs sm:text-sm font-extrabold text-[#7CFF3A]">5-10 Yrs Rust</span>
          </div>
        </div>

      </div>

    </div>
  </div>

</section>
