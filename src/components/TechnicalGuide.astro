---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section id="technical" class="py-20 bg-[#0F1412] border-t border-[#24322B] relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {/* Left Column: Context and Engineering Breakdown */}
      <div class="lg:col-span-6 space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider">
          <span>Local Weather & Metallurgy Guide</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {location.technicalHeadline}
        </h2>

        <p class="text-base text-[#C7CDD1] leading-relaxed">
          {location.technicalSubtitle} Standard residential iron or low-grade stainless steels deteriorate rapidly under Andhra Pradesh's varied microclimates. Here is how D-VIEW engineers durability for <strong class="text-white">{location.name}</strong>.
        </p>

        {/* Environmental Challenge & Solution Box */}
        <div class="space-y-4">
          <div class="bg-[#151C19] border-l-4 border-amber-500 rounded-r-xl p-4 border-y border-r border-[#24322B]">
            <span class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-1">
              Local Environmental Factor
            </span>
            <p class="text-sm text-[#E2E8F0]">
              {location.weatherChallenge}
            </p>
          </div>

          <div class="bg-[#151C19] border-l-4 border-[#7CFF3A] rounded-r-xl p-4 border-y border-r border-[#24322B]">
            <span class="block text-xs font-bold uppercase tracking-wider text-[#7CFF3A] mb-1">
              D-VIEW Engineering Solution
            </span>
            <p class="text-sm text-[#E2E8F0]">
              {location.engineeringSolution}
            </p>
          </div>
        </div>

        {/* Defensible Corrosion Note */}
        <div class="p-4 rounded-xl bg-[#121816] border border-[#24322B] text-xs text-[#94A3B8] leading-relaxed">
          <strong class="text-[#C7CDD1]">Material Integrity Note:</strong> {location.corrosionAdvisory}
        </div>

      </div>

      {/* Right Column: Technical Specification Table & Badge */}
      <div class="lg:col-span-6">
        <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-6 sm:p-8 shadow-2xl relative">
          
          <div class="flex items-center justify-between pb-4 border-b border-[#24322B] mb-6">
            <span class="text-xs font-bold uppercase tracking-wider text-[#94A3B8]">
              {location.name} Specification Standard
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#7CFF3A]/10 text-[#7CFF3A] border border-[#7CFF3A]/20">
              {location.recommendedGrade}
            </span>
          </div>

          <div class="space-y-4">
            {location.technicalSpecs.map((spec) => (
              <div class="bg-[#151C19] rounded-xl p-4 border border-[#24322B] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <span class="text-xs text-[#94A3B8] uppercase tracking-wider font-semibold block">
                    {spec.label}
                  </span>
                  <span class="text-sm font-extrabold text-white">
                    {spec.value}
                  </span>
                </div>
                <div class="text-left sm:text-right">
                  <span class="text-[11px] text-[#7CFF3A] font-medium bg-[#1A2420] px-2.5 py-1 rounded border border-[#24322B]">
                    {spec.note}
                  </span>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-6 pt-5 border-t border-[#24322B] flex items-center justify-between text-xs text-[#94A3B8]">
            <span>Multi-strand stainless steel cable system</span>
            <a href="/contact#book-visit" class="text-[#7CFF3A] font-bold hover:underline">
              Request site measurement →
            </a>
          </div>

        </div>
      </div>

    </div>

  </div>

</section>
