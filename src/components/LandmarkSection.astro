---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section class="relative py-24 bg-[#0B0D0C] overflow-hidden border-t border-[#24322B]">
  
  {/* Panoramic Landmark Backdrop Image with gradient mask */}
  <div class="absolute inset-0 z-0">
    <img 
      src={location.landmarkImage} 
      alt={`${location.name} Landmark View - ${location.landmarkHeadline}`}
      class="w-full h-full object-cover opacity-80"
      loading="lazy"
    />

  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19]/90 border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>Architectural View Protection</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-4">
        {location.landmarkHeadline}
      </h2>

      <p class="text-base sm:text-lg text-[#E2E8F0] leading-relaxed mb-6">
        {location.landmarkSubhead}
      </p>

      {/* Feature Landmark Highlight Box */}
      <div class="bg-[#121816]/90 backdrop-blur-md p-5 rounded-2xl border border-[#24322B] mb-8">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-bold text-[#7CFF3A] uppercase tracking-wider block">
              Featured Local Horizon
            </span>
            <span class="text-sm font-bold text-white">
              {location.landmarkFeature}
            </span>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#book-visit"
          class="px-7 py-3.5 rounded-xl font-extrabold text-sm text-[#0B0D0C] bg-[#7CFF3A] hover:bg-[#8FFF52] transition-colors shadow-lg"
        >
          Book Site Visit in {location.name}
        </a>
        <a
          href="#engineering"
          class="px-6 py-3.5 rounded-xl font-bold text-sm text-white bg-[#151C19]/80 border border-[#24322B] hover:border-[#7CFF3A]/40 transition-colors"
        >
          View Wire Specifications
        </a>
      </div>

    </div>
  </div>

</section>
