---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;

const cards = [
  {
    id: 'child',
    title: "CHILDREN'S SAFETY",
    teluguTitle: 'చిన్న పిల్లల రక్షణ',
    subtitle: 'Zero-climb vertical wire barrier',
    desc: 'High-rise balcony railings matching frames degghara full safe setup. 2-inch vertical intervals with zero horizontal footholds prevent climbing or slipping through.',
    tag: 'Zero-Climb Barrier',
    image: '/assets/pillars/children-safety.png',
    highlight: 'Rigid 50mm wire gap engineered for toddler protection'
  },
  {
    id: 'pet',
    title: 'PETS SAFETY',
    teluguTitle: 'పెంపుడు జంతువుల భద్రత',
    subtitle: 'Gap protection for active dogs & cats',
    desc: 'Cats and dogs cannot slip through balcony gaps. Smooth clear polyamide coating protects pet paws and resists aggressive claw scratching.',
    tag: 'Scratch-Proof Coating',
    image: '/assets/pillars/pets-safety.png',
    highlight: 'Continuous perimeter containment without blocking breeze'
  },
  {
    id: 'elderly',
    title: 'OLD AGE PERSONS SAFETY',
    teluguTitle: 'పెద్దవారికి భరోసా & సపోర్ట్',
    subtitle: 'Psychological comfort at high elevations',
    desc: 'Provides firm structural reassurance for seniors on high-floor balconies, preventing accidental slips, loss of balance, or vertigo hazards.',
    tag: 'Firm Structural Support',
    image: '/assets/pillars/old-age-safety.png',
    highlight: 'Tension calibrated to withstand human body impacts'
  },
  {
    id: 'pigeon',
    title: 'PIGEONS & BIRD DEFENSE',
    teluguTitle: 'పావురాలు & పక్షుల రక్షణ',
    subtitle: 'Zero nesting & stain-free clean balconies',
    desc: '50mm wire intervals effectively prevent pigeons and common birds from entering or perching, keeping your floor clean and hygienic with zero view obstruction.',
    tag: '50mm Bird Screen',
    image: '/assets/pillars/pigeon-control.png',
    highlight: 'Hygienic living without ugly sagging dark nets'
  },
  {
    id: 'emergency',
    title: 'EMERGENCY FIRE ESCAPE',
    teluguTitle: 'అత్యవసర ఫైర్ ఎస్కేప్ సిస్టమ్',
    subtitle: '1-Minute manual wire cutter escape',
    desc: 'Traditional heavy welded iron grilles trap families during fire accidents. D-VIEW high-tensile SS-316 cables can be safely cut in just 1 minute using standard wire cutters.',
    tag: '1-Min Safe Egress',
    image: '/assets/pillars/fire-escape.png',
    highlight: 'Compliant with emergency rescue guidelines'
  },
  {
    id: 'luxury',
    title: 'MODERN LUXURY & FREE AIR',
    teluguTitle: 'లగ్జరీ లుక్ & సహజ గాలివెలుతురు',
    subtitle: 'Unblocked 99% light and sea/river breeze',
    desc: 'Replaces old jail-like iron bars with slim stainless cables that disappear from 5 meters away. Maximizes cross-ventilation and natural daylight in {location.name}.',
    tag: '99% View & Breeze',
    image: '/assets/pillars/modern-airflow.png',
    highlight: 'Luxury apartment association (RWA) facade approved'
  }
];
---

<section id="problems" class="py-20 bg-[#0B0D0C] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>The Complete Problem-Solver Grid</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
        ONE BALCONY. <br />
        <span class="text-[#7CFF3A]">MULTIPLE SAFETY CONCERNS.</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
        Traditional welded iron grilles feel like heavy prison bars, obstruct views, and rust quickly. D-VIEW invisible safety grills deliver verified structural protection while preserving light, breeze, and freedom in {location.name}.
      </p>
    </div>

    {/* Featured 3D Split Transformation Spotlight Card */}
    <div class="mb-14 rounded-3xl overflow-hidden bg-[#121816] border-2 border-[#7CFF3A]/30 hover:border-[#7CFF3A] transition-all duration-300 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
        <div class="lg:col-span-7 relative h-72 sm:h-96 overflow-hidden">
          <img 
            src="/images/balcony-before-after-v2.jpg" 
            alt={`Before vs After Balcony Transformation in ${location.name}`} 
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#121816]/90 via-transparent to-transparent lg:hidden"></div>
          {/* Split comparison labels */}
          <div class="absolute top-4 left-4 bg-red-950/85 backdrop-blur-md px-3 py-1.5 rounded-lg text-[11px] font-bold text-red-200 border border-red-500/40 shadow-lg">
            BEFORE: Traditional Cages
          </div>
          <div class="absolute top-4 right-4 bg-black/80 backdrop-blur-md px-3 py-1.5 rounded-lg text-[11px] font-bold text-[#7CFF3A] border border-[#7CFF3A]/40 shadow-lg">
            AFTER: D-View SS-316
          </div>
        </div>
        <div class="lg:col-span-5 p-6 sm:p-10 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-[11px] font-bold text-[#7CFF3A] uppercase tracking-wider">
            <span>Architectural Transformation</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight">
            See What Life Looks Like <span class="text-[#7CFF3A]">Without Cages</span>
          </h3>
          <p class="text-xs sm:text-sm text-[#C7CDD1] leading-relaxed">
            Direct 50/50 side-by-side comparison: Replace oppressive rusted iron bars, trapped pigeon droppings, and gloomy blocked horizons with 99% transparent SS-316 marine-grade invisible safety cables.
          </p>
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="p-3 rounded-xl bg-[#151C19] border border-[#24322B]">
              <p class="text-[10px] text-gray-400 uppercase font-semibold">View Retention</p>
              <p class="text-sm font-black text-[#7CFF3A]">99% Optical Clarity</p>
            </div>
            <div class="p-3 rounded-xl bg-[#151C19] border border-[#24322B]">
              <p class="text-[10px] text-gray-400 uppercase font-semibold">Pigeon Menace</p>
              <p class="text-sm font-black text-white">Zero Bird Mess</p>
            </div>
          </div>
          <div class="pt-2">
            <a
              href="#book-visit"
              class="inline-flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-[#7CFF3A] text-xs font-black text-black hover:bg-[#68e02d] transition-colors shadow-lg"
            >
              <span>Schedule Free Balcony Measurement</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* 6 Real Solutions Grid with Actual Images */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-14">
      {cards.map((card) => (
        <div class="group bg-[#121816] rounded-3xl border border-[#24322B] overflow-hidden hover:border-[#7CFF3A] transition-all duration-300 flex flex-col justify-between shadow-xl hover:-translate-y-1.5">
          
          <div>
            {/* Image Frame */}
            <div class="relative h-52 overflow-hidden">
              <img 
                src={card.image} 
                alt={`${card.title} - D-VIEW Balcony Safety`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-90"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#121816] via-transparent to-transparent"></div>
              <span class="absolute top-3 left-3 bg-[#0B0D0C]/85 backdrop-blur-md px-3 py-1 rounded-full border border-[#24322B] text-[11px] font-bold text-[#7CFF3A]">
                {card.tag}
              </span>
            </div>

            {/* Content */}
            <div class="p-6">
              <div class="flex items-center justify-between mb-1">
                <h3 class="text-lg font-black text-white group-hover:text-[#7CFF3A] transition-colors">
                  {card.title}
                </h3>
                <span class="text-[11px] text-[#7CFF3A] font-semibold">
                  {card.teluguTitle}
                </span>
              </div>
              <span class="block text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-3">
                {card.subtitle}
              </span>

              <p class="text-xs text-[#C7CDD1] leading-relaxed mb-4">
                {card.desc.replace('{location.name}', location.name)}
              </p>

              <div class="p-2.5 rounded-xl bg-[#151C19] border border-[#24322B] text-[11px] text-[#7CFF3A] font-medium flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#7CFF3A] shrink-0"></span>
                <span>{card.highlight}</span>
              </div>
            </div>
          </div>

          <div class="px-6 pb-6 pt-0">
            <a
              href="#book-visit"
              class="w-full py-2.5 rounded-xl bg-[#1A2420] text-xs font-bold text-white group-hover:bg-[#7CFF3A] group-hover:text-[#0B0D0C] transition-colors flex items-center justify-center gap-1.5"
            >
              <span>Get Free Site Measurement</span>
              <span>→</span>
            </a>
          </div>

        </div>
      ))}
    </div>

    {/* The Closing Statement Line requested by user */}
    <div class="bg-gradient-to-r from-[#151C19] via-[#1A2420] to-[#151C19] rounded-3xl border-2 border-[#7CFF3A] p-6 sm:p-10 text-center shadow-[0_0_35px_rgba(124,255,58,0.25)]">
      <div class="max-w-3xl mx-auto space-y-2">
        <span class="text-xs font-black uppercase tracking-widest text-[#7CFF3A]">
          THE D-VIEW PROMISE
        </span>
        <h3 class="text-xl sm:text-2xl lg:text-3xl font-black text-white tracking-tight leading-snug">
          "Okke Okka Balcony Installation... <br class="hidden sm:inline" />
          <span class="text-[#7CFF3A]">Enno High-Alert Safety Problems Nundi Mee Intiki Life-Time Premium Protection!"</span>
        </h3>
        <p class="text-xs sm:text-sm text-[#C7CDD1] pt-2">
          One single precision installation protects children, pets, and elders while preserving your open views and fresh breezes.
        </p>
      </div>
    </div>

  </div>
</section>
