---
import type { LocationData } from '../data/locations';

interface Props {
  location?: LocationData;
}

const { location } = Astro.props;
const cityName = location ? location.name : 'Andhra Pradesh';

const services = [
  {
    title: 'BALCONY SS-316 & SS-304 INVISIBLE GRILLS',
    subtitle: 'Multi-Strand Stainless Steel System',
    description: 'Our flagship architectural safety solution. High-strength cables spaced at 2 inches preserve 99% of your view while offering balcony fall protection for children, elders, and pets.',
    points: ['SS-316 & SS-304 Cable Options', '6063-T6 Extruded Aluminum Track', '5-Year Warranty (Written Terms with Quote)', 'Zero View Obstruction'],
    link: '#book-visit'
  },
  {
    title: 'WINDOW SAFETY INVISIBLE GRILLS',
    subtitle: 'Slim Corrosion-Resistant Stainless Cable Protection',
    description: 'Replaces bulky iron window bars with sleek, slim stainless steel cables. Delivers maximum daylight and fresh cross-ventilation while preventing accidents.',
    points: ['Flush Sill & Lintel Mounting', 'Child & Pet Fall Prevention', 'Emergency 1-Minute Cut Escape', 'High Aesthetic Appeal'],
    link: '#book-visit'
  },
  {
    title: 'PIGEON & BIRD BARRIER GRILLS',
    subtitle: '2-Inch Vertical Stainless Interval Defense',
    description: 'Eliminate health hazards caused by pigeon perching and droppings. The 50mm wire intervals effectively exclude birds without blocking sunlight or breezy airflow.',
    points: ['Zero Perching Space', 'Hygienic & Odor-Free Balconies', 'Resists Weather & Coastal Sunlight', 'Never Sags or Discolors'],
    link: '#book-visit'
  },
  {
    title: 'HIGH-RISE ELEVATION & TERRACE GRILLS',
    subtitle: 'Aerodynamic Coastal & Penthouse Security',
    description: 'Custom engineered solutions for large penthouse open terraces, high-elevation towers, and corner balustrades engineered for high wind loads and open spans.',
    points: ['Custom Fabricated Anchors', 'Designed for Coastal Wind Exposure', 'Architectural RWA Facade Compliant', 'Turnbuckle Tension Retention'],
    link: '#book-visit'
  }
];
---

<section id="services" class="py-20 bg-slate-50 border-t border-slate-200 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-semibold text-[#16A34A] uppercase tracking-wider mb-4 shadow-sm">
        <span>Complete Protection Portfolio</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        OUR CORE <span class="text-[#16A34A]">SAFETY SOLUTIONS</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        From luxury balcony invisible wire architecture to window safety grills, D-VIEW provides residential invisible grill engineering tailored for {cityName} homes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-7 flex flex-col justify-between hover:border-emerald-500 hover:shadow-xl transition-all group shadow-sm">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#16A34A] block mb-1">
              {service.subtitle}
            </span>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#16A34A] transition-colors mb-3">
              {service.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6 font-normal">
              {service.description}
            </p>

            <ul class="space-y-2 mb-6">
              {service.points.map((pt) => (
                <li class="flex items-center gap-2.5 text-xs text-slate-700 font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#16A34A]"></span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <a 
              href={service.link}
              class="text-xs font-bold text-[#16A34A] hover:underline flex items-center gap-1"
            >
              <span>Get Estimate for {service.title.split(' ')[0]}</span>
              <span>→</span>
            </a>
            <span class="text-[10px] text-slate-500 font-semibold uppercase">D-VIEW Standard</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
