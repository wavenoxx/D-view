---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section id="projects" class="py-20 bg-[#0B0D0C] border-t border-[#24322B] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>Architectural Concept Specifications</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        BALCONY SAFETY LAYOUTS IN <br />
        <span class="text-[#7CFF3A]">{location.name.toUpperCase()}</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
        Explore architectural balcony concepts and layout specifications across residential communities in {location.name}. Note: Illustrative design layouts; exact specifications confirmed upon site consultation.
      </p>
    </div>

    {/* Project Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {location.projects.map((project) => (
        <div class="bg-[#121816] rounded-2xl border border-[#24322B] overflow-hidden hover:border-[#7CFF3A]/50 transition-all duration-300 group flex flex-col justify-between shadow-xl">
          
          <div>
            {/* Image */}
            <div class="relative h-56 overflow-hidden">
              <img 
                src={project.image} 
                alt={`Illustrative layout concept - ${project.title}, ${project.locality}`} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#121816] via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3 bg-[#0B0D0C]/80 backdrop-blur-md px-2.5 py-1 rounded-md border border-[#24322B] text-[11px] font-bold text-[#7CFF3A]">
                {project.wireSpec}
              </div>
            </div>

            {/* Content */}
            <div class="p-6">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg font-black text-white group-hover:text-[#7CFF3A] transition-colors">
                  {project.title}
                </h3>
                <span class="text-xs font-bold text-[#94A3B8] bg-[#1A2420] px-2 py-0.5 rounded border border-[#24322B]">
                  {project.areaSqFt} sq.ft
                </span>
              </div>

              <div class="flex items-center gap-1.5 text-xs text-[#94A3B8] mb-3">
                <svg class="w-3.5 h-3.5 text-[#7CFF3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span>{project.locality}</span>
                <span>•</span>
                <span>{project.propertyType}</span>
              </div>

              <p class="text-xs text-[#C7CDD1] leading-relaxed">
                {project.highlight}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6 pt-2">
            <a
              href="#book-visit"
              class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-bold text-white bg-[#1A2420] hover:bg-[#232E29] border border-[#24322B] group-hover:border-[#7CFF3A]/30 transition-colors"
            >
              <span>Enquire for This Layout Specification</span>
              <span>→</span>
            </a>
          </div>

        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a 
        href="/contact#book-visit"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#7CFF3A] hover:underline"
      >
        <span>Request Site Consultation For Your Balcony</span>
        <span>→</span>
      </a>
    </div>

  </div>
</section>
