---
interface Props {
  cityName?: string;
}

const { cityName = 'Andhra Pradesh' } = Astro.props;

const galleryItems = [
  {
    title: 'Before vs After Balcony Transformation',
    subtitle: 'Direct 50/50 Split: Rusted Cages vs. SS-316 Invisible Safety',
    description: 'Direct side-by-side comparison: heavy rusted iron bars and pigeon droppings transformed into a sun-drenched penthouse terrace with 99% panoramic river views.',
    image: '/images/balcony-before-after-v2.jpg',
    tag: 'BEFORE VS AFTER',
    metric: '50/50 Split'
  },
  {
    title: 'Living Room Horizon View',
    subtitle: 'From Inside Living Room to Endless Sea & River Vistas',
    description: 'Optical clarity that completely dissolves heavy barriers. Residents enjoy 99% unblocked natural light and coastal breezes.',
    image: '/images/vizag-penthouse-terrace-wide.jpg',
    tag: 'INTERIOR PERSPECTIVE',
    metric: '99% View Clarity'
  },
  {
    title: '2-Inch Child & Pet Safety Interval',
    subtitle: 'Strict 50mm Spacing With Zero Horizontal Footholds',
    description: 'Precision vertical spacing prevents toddlers from climbing or slipping, while keeping dogs and cats safely contained.',
    image: '/images/child-safety-balcony.jpg',
    tag: 'FALL PREVENTION',
    metric: 'Zero Foothold'
  },
  {
    title: 'Clean Architectural Corner Anchoring',
    subtitle: 'Concealed Fasteners & Powder-Coated Aluminum Track Fixtures',
    description: '6063-T6 heavy-gauge aluminum profiles anchor firmly into structural concrete, hiding all tension bolts for a flush minimalist line.',
    image: '/images/wire-engineering.jpg',
    tag: 'HARDWARE PRECISION',
    metric: '6063-T6 Aluminum'
  },
  {
    title: 'High-Rise Balcony Cross-Ventilation',
    subtitle: 'Natural River & Ocean Airflow Without Pigeon Intrusion',
    description: 'Unlike solid glass or bulky box bars, high-tensile stainless steel cables preserve unhindered natural air circulation and deter pigeons.',
    image: '/images/rajahmundry-hero.jpg',
    tag: 'VENTILATION & HYGIENE',
    metric: 'Open Airflow'
  },
  {
    title: 'Penthouse & Corner Balcony Elevation',
    subtitle: 'Engineered For 15+ Floor Towers & Coastal Gusts',
    description: 'Engineered for robust structural strength, delivering safety for coastal penthouses and high-elevation residences.',
    image: '/images/project-penthouse.jpg',
    tag: 'HIGH-RISE ENGINEERING',
    metric: 'High Tensile'
  },
  {
    title: 'Smooth Paw-Safe Polyamide Sheath',
    subtitle: 'Virgin Nylon-12 Coating Gentle On Hands & Pet Paws',
    description: 'Transparent protective outer jacket resists claws, eliminates sharp edges, and prevents salt-water chloride accumulation.',
    image: '/images/pet-safety.jpg',
    tag: 'PET & CHILD CARE',
    metric: 'Paw-Safe Nylon-12'
  }
];
---

<section id="gallery" class="py-20 bg-white border-t border-slate-200 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    {/* Section Header - 80% Image / 20% Concise Text Priority */}
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-bold text-[#16A34A] uppercase tracking-wider mb-3 shadow-sm">
          <span>Real Balcony Installations</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          VISUAL PROOF: <span class="text-[#16A34A]">LUXURY INVISIBLE GRILLS</span>
        </h2>
      </div>
      <p class="mt-3 md:mt-0 text-xs sm:text-sm text-slate-600 max-w-md font-normal">
        Real installation photography showing inside-out balcony horizons, 2-inch child safety spacing, and flush architectural corner tracks.
      </p>
    </div>

    {/* Image-First Gallery Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {galleryItems.map((item) => (
        <div class="group relative rounded-2xl overflow-hidden bg-white border border-slate-200 hover:border-emerald-500 transition-all duration-300 shadow-sm hover:shadow-xl flex flex-col justify-between">
          
          {/* 80% High-Definition Visual Frame */}
          <div class="relative h-72 sm:h-80 overflow-hidden">
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter contrast-[1.02]"
              loading="lazy"
            />
            {/* Subtle Gradient vignette */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>

            {/* Top pill tags */}
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-white/95 text-[#16A34A] border border-emerald-200 shadow-sm">
                {item.tag}
              </span>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-black text-white bg-slate-900/80 backdrop-blur-md">
                {item.metric}
              </span>
            </div>

            {item.tag === 'BEFORE VS AFTER' && (
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between pointer-events-none z-10">
                <span class="px-2 py-0.5 rounded bg-rose-950/80 text-[9px] font-bold text-rose-200 border border-rose-500/40 backdrop-blur-sm">
                  BEFORE: Cages
                </span>
                <span class="px-2 py-0.5 rounded bg-emerald-950/80 text-[9px] font-bold text-emerald-300 border border-emerald-500/40 backdrop-blur-sm">
                  AFTER: SS-316
                </span>
              </div>
            )}
          </div>

          {/* 20% Concise Modern Micro-copy */}
          <div class="p-6 space-y-2">
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#16A34A] transition-colors">
              {item.title}
            </h3>
            <span class="block text-xs font-bold text-[#16A34A] leading-snug">
              {item.subtitle}
            </span>
            <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 font-normal">
              {item.description}
            </p>
          </div>

          {/* Bottom Action Line */}
          <div class="px-6 pb-5 pt-0">
            <a 
              href="/contact#book-visit" 
              class="w-full py-2.5 rounded-xl bg-slate-100 text-xs font-bold text-slate-700 hover:bg-[#16A34A] hover:text-white transition-colors text-center flex items-center justify-center gap-1.5 border border-slate-200 hover:border-emerald-600"
            >
              <span>Book Free Site Visit</span>
              <span>→</span>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
