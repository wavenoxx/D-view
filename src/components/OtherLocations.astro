---
import { ALL_LOCATIONS } from '../data/locations';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const otherLocations = ALL_LOCATIONS.filter((loc) => loc.slug !== currentSlug);
---

<section class="py-20 bg-[#0B0D0C] border-t border-[#24322B] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>Andhra Pradesh Regional Network</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        EXPLORE OTHER <span class="text-[#7CFF3A]">D-VIEW LOCATIONS</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#C7CDD1]">
        Discover location-tailored architectural safety solutions engineered for other major coastal and riverfront cities across the state.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {otherLocations.map((loc) => (
        <a 
          href={`/locations/${loc.slug}`}
          class="group bg-[#121816] rounded-2xl border border-[#24322B] overflow-hidden hover:border-[#7CFF3A] hover:bg-[#151C19] transition-all duration-300 flex flex-col justify-between shadow-lg hover:-translate-y-1"
        >
          <div>
            <div class="relative h-36 overflow-hidden">
              <img 
                src={loc.heroImage} 
                alt={`${loc.name} Invisible Grills`}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#121816] via-transparent to-transparent"></div>
              <span class="absolute bottom-2 left-2 text-[10px] font-bold text-[#7CFF3A] bg-[#0B0D0C]/80 px-2 py-0.5 rounded border border-[#24322B]">
                {loc.district}
              </span>
            </div>

            <div class="p-4">
              <h3 class="text-base font-extrabold text-white group-hover:text-[#7CFF3A] transition-colors mb-1">
                {loc.name}
              </h3>
              <p class="text-xs text-[#94A3B8] line-clamp-2 leading-relaxed">
                {loc.heroSubhead}
              </p>
            </div>
          </div>

          <div class="p-4 pt-0">
            <span class="w-full py-2 rounded-lg bg-[#1A2420] text-xs font-bold text-[#C7CDD1] group-hover:text-[#0B0D0C] group-hover:bg-[#7CFF3A] transition-colors flex items-center justify-center gap-1">
              <span>Explore {loc.name}</span>
              <span>→</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a 
        href="/locations"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#151C19] border border-[#24322B] text-xs font-bold text-[#7CFF3A] hover:bg-[#1A2420] hover:border-[#7CFF3A]/40 transition-colors"
      >
        <span>View Full 6-City Hub Dashboard</span>
        <span>→</span>
      </a>
    </div>

  </div>
</section>
