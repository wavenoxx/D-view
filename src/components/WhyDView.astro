---
import type { LocationData } from '../data/locations';

interface Props {
  location?: LocationData;
}

const { location } = Astro.props;
const cityName = location ? location.name : 'Andhra Pradesh';

const pillars = [
  {
    title: 'SS-316 & SS-304 Material Options',
    desc: 'We offer genuine SS-316 marine-grade cables for high-salinity coastal environments and durable SS-304 options for standard urban balconies based on site requirements.',
    tag: 'Grade Options'
  },
  {
    title: 'Accurate Laser Measurement',
    desc: 'Our engineers utilize Leica digital laser meters to gauge structural square-footage with sub-millimeter precision, guaranteeing exact tension alignment.',
    tag: 'Digital Accuracy'
  },
  {
    title: 'Trained Installation Technicians',
    desc: 'Our installation technicians are trained on high-rise safety protocols, correct anchor embedment, and tension alignment.',
    tag: 'Trained Technicians'
  },
  {
    title: 'Itemized Written Invoices',
    desc: 'Clear, itemized pricing confirmed in your written quotation prior to work commencing, with no unexpected site surprises.',
    tag: 'Clear Invoicing'
  },
  {
    title: '5-Year Warranty',
    desc: '5-year warranty; coverage, conditions, and maintenance guidelines are confirmed in the written quotation provided prior to installation.',
    tag: '5-Year Warranty'
  },
  {
    title: `Site Visit & Measurement Coordination`,
    desc: 'Site visits can be arranged within 48 hours after confirmation, subject to location and operational availability.',
    tag: 'Doorstep Coordination'
  }
];
---

<section class="py-20 bg-slate-50 border-t border-slate-200 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-semibold text-[#16A34A] uppercase tracking-wider mb-4">
        <span>The D-VIEW Standard</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        WHY PROPERTY OWNERS IN <br />
        <span class="text-[#16A34A]">{cityName.toUpperCase()} TRUST D-VIEW</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Balcony safety is a life-critical installation. Here is why discerning architects, high-rise builders, and families choose our engineering approach.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((p, index) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:border-emerald-500 hover:shadow-xl transition-all flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-extrabold text-[#16A34A] bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
                0{index + 1}
              </span>
              <span class="text-[11px] font-semibold text-slate-500">
                {p.tag}
              </span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">
              {p.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {p.desc}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-slate-100 text-[11px] text-slate-400">
            D-VIEW Quality Assured
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
