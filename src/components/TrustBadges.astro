---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section class="py-20 bg-[#0F1412] border-t border-[#24322B] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Trust Badges Grid */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-16">
      
      <div class="bg-[#121816] p-5 sm:p-6 rounded-2xl border border-[#24322B] text-center flex flex-col items-center justify-center">
        <div class="w-12 h-12 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <span class="text-xl sm:text-2xl font-black text-white block">5 Years</span>
        <span class="text-xs text-[#94A3B8] font-medium mt-1">Warranty Terms With Quote</span>
      </div>

      <div class="bg-[#121816] p-5 sm:p-6 rounded-2xl border border-[#24322B] text-center flex flex-col items-center justify-center">
        <div class="w-12 h-12 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <span class="text-xl sm:text-2xl font-black text-white block">4 to 6 Hours</span>
        <span class="text-xs text-[#94A3B8] font-medium mt-1">Clean, Zero-Mess Installation</span>
      </div>

      <div class="bg-[#121816] p-5 sm:p-6 rounded-2xl border border-[#24322B] text-center flex flex-col items-center justify-center">
        <div class="w-12 h-12 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <span class="text-xl sm:text-2xl font-black text-white block">SS-316 & SS-304</span>
        <span class="text-xs text-[#94A3B8] font-medium mt-1">Material Options Offered</span>
      </div>

      <div class="bg-[#121816] p-5 sm:p-6 rounded-2xl border border-[#24322B] text-center flex flex-col items-center justify-center">
        <div class="w-12 h-12 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
        </div>
        <span class="text-xl sm:text-2xl font-black text-white block">{location.name}</span>
        <span class="text-xs text-[#94A3B8] font-medium mt-1">Enquire For Service Coverage</span>
      </div>

    </div>
  </div>
</section>
