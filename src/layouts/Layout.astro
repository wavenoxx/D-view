---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  cityName?: string;
  ogImage?: string;
  preloadHeroImage?: string;
  preloadMobileHeroImage?: string;
  keywords?: string[];
  hideFloatingButtons?: boolean;
  showIntroAnimation?: boolean;
  faqs?: { question: string; answer: string }[];
}

const {
  title,
  description,
  canonicalUrl = 'https://www.dviewsolutions.com/',
  cityName = 'Andhra Pradesh',
  ogImage = '/images/visakhapatnam-hero.jpg',
  preloadHeroImage,
  preloadMobileHeroImage,
  keywords = ['invisible grills andhra pradesh', 'balcony safety solutions', 'ss 316 invisible grills', 'coastal balcony safety', '6281620716', '62816 20716', '+91 62816 20716'],
  hideFloatingButtons = false,
  showIntroAnimation = false,
  faqs = []
} = Astro.props;

// Normalize canonical URL: root '/' keeps trailing slash; all non-root paths omit trailing slash
const normalizedCanonicalUrl = canonicalUrl === 'https://www.dviewsolutions.com/' || canonicalUrl === 'https://www.dviewsolutions.com'
  ? 'https://www.dviewsolutions.com/'
  : canonicalUrl.replace(/\/+$/, '');

// Ensure Open Graph image URL is fully-qualified absolute URL
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : `https://www.dviewsolutions.com${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "https://www.dviewsolutions.com/#business",
  "name": "D-VIEW Solutions",
  "alternateName": ["D-View Invisible Grills", "D-VIEW", "6281620716", "+91 62816 20716"],
  "logo": "https://www.dviewsolutions.com/images/d-view-logo-horizontal.png",
  "image": "https://www.dviewsolutions.com/assets/locations/rajahmundry.png",
  "telephone": "+916281620716",
  "email": "dviewsolutions32@gmail.com",
  "url": "https://www.dviewsolutions.com/",
  "priceRange": "₹₹",
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+916281620716",
      "contactType": "customer service",
      "contactOption": "TollFree",
      "areaServed": "IN-AP",
      "availableLanguage": ["English", "Telugu", "Hindi"]
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "Andhra Pradesh",
    "addressCountry": "IN"
  },
  "areaServed": [
    { "@type": "City", "name": "Visakhapatnam" },
    { "@type": "City", "name": "Rajahmundry" },
    { "@type": "City", "name": "Vijayawada" },
    { "@type": "City", "name": "Kakinada" },
    { "@type": "City", "name": "Guntur" },
    { "@type": "City", "name": "Nellore" },
    { "@type": "City", "name": "Ongole" },
    { "@type": "AdministrativeArea", "name": "Andhra Pradesh" }
  ],
  "serviceType": "Invisible Grills and Balcony Safety Solutions",
  "description": description || "Architectural SS-316 & SS-304 invisible safety grills for apartments, balcony child fall safety deterrence, pet security, and pigeon deterrence with 5-year warranty across Andhra Pradesh."
};

const faqSchema = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth no-scrollbar">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" href="/images/d-view-emblem.png" />
    <link rel="apple-touch-icon" href="/images/d-view-emblem.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={normalizedCanonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="geo.region" content="IN-AP" />
    <meta name="geo.placename" content={cityName} />
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="D-VIEW Solutions" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={normalizedCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={normalizedCanonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- High-Priority LCP Hero Image Preload for Mobile Core Web Vitals -->
    {preloadMobileHeroImage && preloadHeroImage ? (
      <>
        <link rel="preload" as="image" href={preloadMobileHeroImage} media="(max-width: 768px)" fetchpriority="high" />
        <link rel="preload" as="image" href={preloadHeroImage} media="(min-width: 769px)" fetchpriority="high" />
      </>
    ) : preloadHeroImage ? (
      <link rel="preload" as="image" href={preloadHeroImage} fetchpriority="high" />
    ) : null}

    <!-- Google Font: Plus Jakarta Sans (Non-blocking performance load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    </noscript>

    <!-- Structured Data Schema (Local Business) -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Structured Data Schema (FAQPage if present) -->
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18513376665"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18513376665');
    </script>
  </head>
  <body class="bg-white text-slate-900 antialiased selection:bg-[#16A34A] selection:text-white no-scrollbar">
    {showIntroAnimation && (
      <div class="dview-intro" aria-hidden="true">
        <div class="dview-intro-inner">
          <div class="dview-intro-grill">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="dview-intro-wordmark">D-VIEW</div>
          <div class="dview-intro-caption">INVISIBLE GRILLS · OPEN VIEWS</div>
        </div>
      </div>
    )}

    <slot />

    {!hideFloatingButtons && (
      <>
        <!-- Floating Direct Call Button (Desktop Only, Bottom Left) -->
        <a
          href="tel:+916281620716"
          aria-label="Direct Call Helpline"
          class="hidden md:flex fixed bottom-6 left-6 z-50 w-12 h-12 rounded-full bg-white/95 hover:bg-slate-50 border-2 border-slate-200 hover:border-[#16A34A] text-slate-800 hover:text-[#16A34A] items-center justify-center shadow-xl backdrop-blur-md transition-all hover:scale-110 active:scale-95 group"
        >
          <svg class="w-5 h-5 text-[#16A34A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="absolute left-14 bg-slate-900 text-white text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-800 shadow-xl whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
            Call Now
          </span>
        </a>

        <!-- Floating WhatsApp Quick Connect (Desktop Only, Bottom Right) -->
        <a
          href="https://wa.me/916281620716?text=Hello%20D-view%20invisible%20grills%2C%20I%20am%20interested%20in%20invisible%20safety%20grills%20for%20my%20balcony.%20Please%20share%20details."
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Chat on WhatsApp"
          class="hidden md:flex fixed bottom-6 right-6 z-50 w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white items-center justify-center shadow-[0_4px_25px_rgba(37,211,102,0.6)] transition-all hover:scale-110 active:scale-95 group cursor-pointer border-2 border-white/20"
        >
          <svg class="w-7 h-7 sm:w-8 sm:h-8 fill-current text-white drop-shadow-sm" viewBox="0 0 448 512" aria-hidden="true">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
          <span class="absolute right-16 bg-slate-900 text-white text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-800 shadow-xl whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
            Chat on WhatsApp
          </span>
        </a>
      </>
    )}

    <!-- Mobile-Only Sticky Bottom Action Bar (Thumb-friendly minimum 48px tap targets, 0-CLS) -->
    <aside aria-label="Mobile Quick Actions" class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 px-3 py-2 safe-bottom-pad shadow-[0_-4px_20px_rgba(0,0,0,0.08)] flex items-center justify-between gap-2">
      <!-- Call Helpline (48px tap target) -->
      <a
        href="tel:+916281620716"
        aria-label="Direct Call Helpline"
        class="flex-1 min-h-[48px] h-12 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-98 text-slate-800 font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 border border-slate-300 transition-all cursor-pointer shadow-sm"
      >
        <svg class="w-4 h-4 text-[#16A34A] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Now</span>
      </a>

      <!-- WhatsApp / Free Visit (48px tap target) -->
      <a
        href="https://wa.me/916281620716?text=Hello%20D-view%20invisible%20grills%2C%20I%20am%20interested%20in%20invisible%20safety%20grills%20for%20my%20balcony.%20Please%20share%20details."
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Book Free Visit on WhatsApp"
        class="flex-1 min-h-[48px] h-12 rounded-xl bg-[#16A34A] hover:bg-emerald-700 active:scale-98 text-white font-extrabold text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 shadow-md transition-all cursor-pointer"
      >
        <svg class="w-4 h-4 fill-current text-white shrink-0" viewBox="0 0 448 512" aria-hidden="true">
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        <span>Free Visit</span>
      </a>
    </aside>
  </body>
</html>
