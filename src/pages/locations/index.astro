---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { ALL_LOCATIONS } from '../../data/locations';
---

<Layout
  title="Regional Architectural Safety Corridors | D-VIEW Solutions"
  description="Select a city corridor to explore SS-316 & SS-304 invisible safety grill engineering specifications for regional residential developments."
  canonicalUrl="https://www.dviewsolutions.com/locations"
>
  <Navbar client:load />

  <main class="pt-28 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Header */}
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-semibold text-[#16A34A] uppercase tracking-wider mb-4 shadow-sm">
          <span>Regional Safety & Specification Network</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight">
          Find D-VIEW Safety <br />
          <span class="text-[#16A34A]">Solutions Near You</span>
        </h1>
        <p class="mt-4 text-base sm:text-xl text-slate-600 leading-relaxed font-normal">
          Explore safety solutions designed around your city, property and lifestyle. Each hub provides climate-specific wire engineering, local laser measurements, and direct technician support.
        </p>
      </div>

      {/* 7 Location Hub Cards */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {ALL_LOCATIONS.map((loc) => {
          const canonicalSlug = loc.slug === 'vijayawada-amaravati' ? 'vijayawada' : loc.slug;
          return (
          <a
            href={`/${canonicalSlug}`}
            class="group bg-white rounded-3xl border border-slate-200 overflow-hidden hover:border-emerald-500 transition-all duration-300 flex flex-col justify-between shadow-sm hover:shadow-xl hover:-translate-y-1"
          >
            <div>
              {/* Image Frame */}
              <div class="relative h-60 overflow-hidden">
                <img
                  src={loc.heroImage}
                  alt={loc.heroImageAlt || `D-VIEW Invisible Grills ${loc.name}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter contrast-[1.02]"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-3 py-1 rounded-full border border-emerald-200 text-xs font-bold text-[#16A34A] shadow-sm">
                  {loc.badge.split(' • ')[1] || 'SAFETY HUB'}
                </div>
                <div class="absolute bottom-3 left-4 text-xs font-bold text-white drop-shadow">
                  {loc.district} District
                </div>
              </div>

              {/* Body */}
              <div class="p-6">
                <div class="flex items-center justify-between mb-2">
                  <h2 class="text-2xl font-black text-slate-900 group-hover:text-[#16A34A] transition-colors">
                    {loc.name}
                  </h2>
                  <span class="text-xs font-bold text-[#16A34A] bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">
                    SS-316
                  </span>
                </div>

                <p class="text-xs text-slate-600 leading-relaxed mb-5 line-clamp-2 font-normal">
                  {loc.heroSubhead}
                </p>

                {/* Key Local Areas Served */}
                <div class="pt-4 border-t border-slate-100">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block mb-2">
                    Key Localities Served:
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {loc.areas.slice(0, 4).map((area) => (
                      <span class="text-[11px] bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md border border-slate-200 font-medium">
                        {area.name}
                      </span>
                    ))}
                    {loc.areas.length > 4 && (
                      <span class="text-[11px] bg-emerald-50 text-[#16A34A] px-2 py-1 rounded-md border border-emerald-200 font-bold">
                        +{loc.areas.length - 4} more
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </div>

            {/* CTA Footer */}
            <div class="p-6 pt-0">
              <div class="w-full py-3 rounded-xl bg-slate-100 text-xs font-bold text-slate-800 group-hover:bg-[#16A34A] group-hover:text-white transition-colors flex items-center justify-center gap-2 border border-slate-200 group-hover:border-emerald-600">
                <span>Explore {loc.name} Hub</span>
                <span>→</span>
              </div>
            </div>
          </a>
        );
        })}
      </div>

      {/* Free Site Visit Callout */}
      <div class="mt-16 bg-gradient-to-r from-emerald-50 via-white to-emerald-50 rounded-3xl border border-emerald-200 p-8 sm:p-12 text-center max-w-4xl mx-auto shadow-sm">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
          Need a Custom Multi-Balcony Consultation?
        </h2>
        <p class="text-sm text-slate-600 mb-6 max-w-xl mx-auto font-normal">
          Our service coordination team can arrange a site measurement consultation within 48 hours after confirmation, subject to location and availability.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="tel:+916281620716"
            class="px-8 py-3.5 rounded-xl font-bold text-sm text-white bg-[#16A34A] hover:bg-emerald-700 transition-colors shadow-md"
          >
            Call Helpline: +91 62816 20716
          </a>
          <a
            href="https://wa.me/916281620716?text=Hello%20D-view%20invisible%20grills%2C%20I%20am%20interested%20in%20invisible%20safety%20grills%20for%20my%20balcony.%20Please%20share%20details."
            target="_blank"
            rel="noopener noreferrer"
            class="px-7 py-3.5 rounded-xl font-bold text-sm text-slate-800 bg-white border border-slate-300 hover:border-emerald-500 transition-colors shadow-sm"
          >
            WhatsApp Instant Inquiry
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
