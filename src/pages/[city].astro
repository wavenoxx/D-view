---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import HorizontalProblemSlider from '../components/HorizontalProblemSlider';
import OptimizedGrillImage from '../components/OptimizedGrillImage.astro';
import { ALL_LOCATIONS, type LocationData } from '../data/locations';

export async function getStaticPaths() {
  const cityAliases: Record<string, string> = {
    'vizag': 'visakhapatnam',
    'visakhapatnam': 'visakhapatnam',
    'rajahmundry': 'rajahmundry',
    'rajamahendravaram': 'rajahmundry',
    'vijayawada': 'vijayawada-amaravati',
    'amaravati': 'vijayawada-amaravati',
    'vijayawada-amaravati': 'vijayawada-amaravati',
    'guntur': 'guntur',
    'kakinada': 'kakinada',
    'nellore': 'nellore',
    'ongole': 'ongole'
  };

  return Object.entries(cityAliases).map(([citySlug, targetSlug]) => {
    const locData = ALL_LOCATIONS.find(l => l.slug === targetSlug) || ALL_LOCATIONS[0];
    return {
      params: { city: citySlug },
      props: { location: locData, slug: citySlug }
    };
  });
}

interface Props {
  location: LocationData;
  slug: string;
}

const { location, slug } = Astro.props;

const cityName = location.cityName || location.name;
const heroImage = location.heroImage;
const heroPoster = location.heroPosterImage || location.heroImage;
const subLocalities = location.subLocalities || [];
// Multiple aliases render identical content: identify one canonical city URL.
const primaryCitySlug = location.slug === 'vijayawada-amaravati' ? 'vijayawada' : location.slug;
---

<Layout
  title={location.seoTitle || `D-VIEW Invisible Safety | ${cityName} SS-316 Balcony Grills`}
  description={location.seoDescription || `Engineered invisible safety grills across ${cityName}. Living spaces without fear & without cages. Child & pet fall safety with 5-year warranty.`}
  canonicalUrl={`https://www.dviewsolutions.com/${primaryCitySlug}`}
  cityName={cityName}
  ogImage={heroImage}
  preloadHeroImage={heroPoster}
  keywords={location.keywords}
>
  <main class="min-h-screen bg-white text-slate-900">
    {/* TOP BRAND NAVIGATION BAR MATCHING REFERENCE SCREENSHOT */}
    <header class="w-full bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-2">
        
        {/* Left: Brand Logo in a clean straight line */}
        <a href="/" class="flex items-center gap-2 sm:gap-3 group shrink-0">
          <img 
            src="/images/d-view-logo-horizontal.png" 
            alt="D-VIEW Invisible Grills & Safety Solutions" 
            width="160"
            height="40"
            decoding="async"
            class="h-7 sm:h-9 lg:h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105" 
          />
        </a>

        {/* Middle: Navigation Links */}
        <nav aria-label="Primary Navigation" class="hidden md:flex items-center gap-4 lg:gap-7 text-xs font-bold tracking-wider uppercase shrink-0">
          <a href="/" class="py-2 text-[#16A34A] hover:text-emerald-700 transition flex items-center gap-1">
            Home
          </a>
          <a href="#corridors" class="py-2 text-slate-600 hover:text-[#16A34A] transition">
            Applications
          </a>
          <a href="/solutions" class="py-2 text-slate-600 hover:text-[#16A34A] transition">
            Solutions
          </a>
          <a href="/about" class="py-2 text-slate-600 hover:text-[#16A34A] transition">
            About
          </a>
          <a href="/contact" class="py-2 text-slate-600 hover:text-[#16A34A] transition">
            Contact
          </a>
        </nav>

        {/* Right: City Service Area Pill Badge + Mobile Menu Toggle */}
        <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
          <div class="flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full bg-slate-50 border border-emerald-300 text-right shadow-sm min-w-0 max-w-[145px] sm:max-w-[220px] lg:max-w-none">
            <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-[#16A34A] animate-pulse shrink-0"></span>
            <div class="min-w-0">
              <span class="block text-[10px] sm:text-xs font-black text-slate-900 truncate">{cityName}</span>
              <span class="block text-[8px] sm:text-[9px] font-semibold text-[#16A34A] uppercase tracking-wider truncate">Our Service Area</span>
            </div>
            <span class="hidden sm:inline text-base text-slate-400 ml-0.5 shrink-0" aria-hidden="true">🌉</span>
          </div>

          <button
            type="button"
            id="city-mobile-menu-btn"
            aria-label="Toggle Navigation Menu"
            aria-expanded="false"
            aria-controls="city-mobile-menu"
            class="md:hidden p-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-800 hover:text-[#16A34A] transition shrink-0 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

      </div>

      {/* Mobile Navigation Drawer */}
      <nav
        id="city-mobile-menu"
        aria-label="Mobile Navigation"
        class="hidden md:hidden border-t border-slate-200 bg-white/98 backdrop-blur-xl px-4 py-3 space-y-1 shadow-xl"
      >
        <a href="/" class="block px-3 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-[#16A34A] hover:bg-emerald-50">
          Home
        </a>
        <a href="#corridors" class="block px-3 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50 hover:text-[#16A34A]">
          {cityName} Corridors & Applications
        </a>
        <a href={`/safety-pillars/${primaryCitySlug}`} class="block px-3 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50 hover:text-[#16A34A]">
          6-Pillar Safety Solutions
        </a>
        <a href="/solutions" class="block px-3 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50 hover:text-[#16A34A]">
          All Engineering Solutions
        </a>
        <a href="/projects" class="block px-3 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50 hover:text-[#16A34A]">
          Projects Portfolio
        </a>
        <a href="/about" class="block px-3 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50 hover:text-[#16A34A]">
          About D-VIEW
        </a>
        <a href={`/contact?city=${slug}#book-visit`} class="block px-3 py-2.5 rounded-xl text-xs font-extrabold uppercase tracking-wider text-slate-950 bg-[#7CFF3A] text-center mt-2">
          Book Free Site Visit →
        </a>
      </nav>
    </header>
    <script is:inline>
      (() => {
        const btn = document.getElementById('city-mobile-menu-btn');
        const menu = document.getElementById('city-mobile-menu');
        if (!btn || !menu) return;
        const closeMenu = () => {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        };
        btn.addEventListener('click', () => {
          const isHidden = menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        });
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenu();
        });
      })();
    </script>

    {/* TIER 1: 4:5 CITY POSTER CARD SHOWCASE (IMAGE HIGHLIGHTED - ZERO VIEW BLOCKING) */}
    <section class="relative w-full bg-slate-50 py-4 sm:py-8 lg:py-10 border-b border-slate-200 overflow-hidden">
      <!-- Subtle ambient background glow -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-[600px] h-[400px] bg-emerald-400/10 blur-[120px] pointer-events-none rounded-full"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 w-full">
        {/* 4:5 POSTER CARD */}
        <div class="max-w-md sm:max-w-lg mx-auto w-full flex flex-col items-center">
          
          <div class="relative w-full aspect-[4/5] rounded-3xl overflow-hidden border-2 border-emerald-500 bg-white shadow-2xl group">
            {/* 100% Full-bleed background image with unobstructed center */}
            <OptimizedGrillImage
              src={heroPoster}
              alt={location.heroImageAlt || `D-VIEW Invisible Safety in ${cityName}`}
              aspectRatio="4/5"
              sizes="(max-width: 640px) 95vw, 512px"
              class="w-full h-full"
              imageClass="object-center rounded-3xl transition-transform duration-500 group-hover:scale-[1.01]"
              width={512}
              height={640}
              priority={true}
              sharpen={true}
            />

            {/* LOWER THIRD TIGHT GRADIENT & CONTENT ANCHORED AT THE VERY BOTTOM */}
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/95 via-black/75 to-transparent pt-14 pb-3 sm:pb-4 px-3 sm:px-4 text-center z-10 flex flex-col justify-end">
              
              {/* Kicker: Small, neat, non-intrusive */}
              <p class="text-[9px] sm:text-[10px] font-bold tracking-[0.2em] text-[#7CFF3A] uppercase mb-0.5 drop-shadow">
                {location.badge || `ARCHITECTURAL PROTECTION · ${cityName.toUpperCase()}`}
              </p>

              {/* Primary Semantic H1: Compact, crisp, perfect mapping to Search Console */}
              <h1 class="text-sm sm:text-base md:text-lg font-black text-white uppercase tracking-wide leading-tight mb-1 drop-shadow-md">
                {location.heroHeadline || `INVISIBLE GRILLS IN ${cityName.toUpperCase()}`}
              </h1>

              {/* Subhead Description: Little bit / compact */}
              <p class="text-[10px] sm:text-xs text-slate-200/90 leading-tight mb-2.5 line-clamp-2 max-w-sm mx-auto drop-shadow">
                {location.heroSubhead || `Slim stainless steel cables for balconies and windows in ${cityName} designed for uncompromised views, fresh air and child safety.`}
              </p>

              {/* 3 SMALL BUTTONS IN ONE SINGLE LINE (Call Us, Free Visit, WhatsApp) */}
              <div class="grid grid-cols-3 gap-1.5 sm:gap-2 w-full">
                {/* 1. Call Us */}
                <a
                  href="tel:+916281620716"
                  class="inline-flex items-center justify-center gap-1 px-1.5 sm:px-2 py-2.5 rounded-xl bg-white/95 hover:bg-white text-slate-900 hover:text-[#16A34A] border border-slate-200 text-[10px] sm:text-xs font-bold transition-all shadow-md text-center"
                >
                  <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-[#16A34A] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span class="truncate">Call Us</span>
                </a>

                {/* 2. Free Visit */}
                <a
                  href={`/contact?city=${slug}#book-visit`}
                  class="inline-flex items-center justify-center gap-1 px-1.5 sm:px-2 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white border border-emerald-400 text-[10px] sm:text-xs font-bold transition-all shadow-md text-center"
                >
                  <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-white flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                  </svg>
                  <span class="truncate">Free Visit</span>
                </a>

                {/* 3. WhatsApp */}
                <a
                  href={`https://wa.me/916281620716?text=${encodeURIComponent(`Hello D-view invisible grills, I am interested in invisible safety grills for my balcony in ${cityName}. Please share details.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-1 px-1.5 sm:px-2 py-2.5 rounded-xl bg-white/95 hover:bg-white text-slate-900 hover:text-[#25D366] border border-slate-200 text-[10px] sm:text-xs font-bold transition-all shadow-md text-center"
                >
                  <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-[#25D366] fill-current flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  <span class="truncate">WhatsApp</span>
                </a>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    {/* TIER 2: HORIZONTAL SLIDING VIEW (LEFT TO RIGHT SCROLLING CARDS) */}
    <div id="problem-solutions" class="w-full overflow-hidden">
      <HorizontalProblemSlider client:visible cityName={cityName} citySlug={slug} />
    </div>

    {/* INTERACTIVE 9:16 LIVE DRAG SLIDER */}
    <section class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200">
      <div class="text-center max-w-2xl mx-auto mb-4">
        <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-50 border border-emerald-300 text-[#16A34A] text-xs font-bold tracking-widest uppercase mb-1.5">
          Live Interactive Handle
        </span>
        <h2 class="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Drag to Compare: <span class="text-[#16A34A]">Traditional Cages vs Sleek Invisible Grills</span>
        </h2>
      </div>
      <BeforeAfterSlider client:visible />
    </section>

    {/* TIER 3: REGIONAL SUB-LOCALITIES / SUB-PAGES GRID */}
    <section id="corridors" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-50 border border-emerald-300 text-[#16A34A] text-xs font-bold tracking-widest uppercase mb-3">
          Regional Architectural Corridors
        </span>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight break-words">
          Active Residential Belts in <span class="text-[#16A34A]">{cityName}</span>
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600">
          Tailored on-site measurements and architectural safety specifications across premier high-rise and residential communities.
        </p>
      </div>

      <!-- Grid of Sub-Localities -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {subLocalities.map((sub, idx) => (
          <a
            href={sub.path || `/safety-pillars/${slug}?corridor=${encodeURIComponent(sub.name)}`}
            class="group rounded-2xl bg-white border border-slate-200 hover:border-emerald-500 overflow-hidden transition-all duration-300 hover:shadow-xl flex flex-col justify-between hover:-translate-y-1.5 block cursor-pointer"
          >
            <!-- Card Image with Gradient Overlay & Badges -->
            <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-slate-100">
              {sub.image ? (
                <OptimizedGrillImage
                  src={sub.image}
                  alt={`${sub.name} - Invisible Safety Grill Installation in ${cityName}`}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                  class="w-full h-full"
                  imageClass="group-hover:scale-105 transition-transform duration-500"
                  width={400}
                  height={208}
                  aspectRatio="4/3"
                  loading="lazy"
                  sharpen={true}
                />
              ) : (
                <div class="w-full h-full bg-slate-100 flex items-center justify-center text-slate-500 text-xs">
                  {sub.name}
                </div>
              )}
              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none z-10" />

              {sub.tag && (
                <div class="absolute bottom-2 left-3 right-3 pointer-events-none z-10">
                  <span class="inline-block text-[9.5px] font-bold text-emerald-800 bg-white/95 backdrop-blur-md px-2 py-0.5 rounded border border-emerald-200 truncate max-w-full shadow-sm">
                    {sub.tag}
                  </span>
                </div>
              )}
            </div>

            <!-- Card Content -->
            <div class="p-5 flex-1 flex flex-col justify-between bg-white">
              <div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-[#16A34A] transition-colors leading-snug">
                  {sub.name}
                </h3>
                <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-2">
                  {sub.desc}
                </p>

                <div class="mt-4 flex flex-wrap gap-1.5 text-[10px] font-semibold text-slate-600">
                  <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-700">SS-316 Option</span>
                  <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-700">2" Safe Spacing</span>
                  <span class="px-2 py-0.5 rounded bg-emerald-50 border border-emerald-300 text-[#16A34A]">Design Concept</span>
                </div>
              </div>

              <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-[#16A34A] group-hover:text-emerald-700 transition-colors">
                <span>View Design Specifications</span>
                <span class="w-6 h-6 rounded-full bg-emerald-50 text-[#16A34A] group-hover:bg-[#16A34A] group-hover:text-white flex items-center justify-center transition-all group-hover:translate-x-1">
                  →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* WEATHER SHIELD SECTION FOR CITY (ZERO GIFT KIT) */}
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs uppercase tracking-[0.3em] text-[#16A34A] font-bold block">
            SS-316 & SS-304 METALLURGY SPECIFICATIONS
          </span>
          <h2 class="text-xl sm:text-3xl md:text-4xl font-extrabold uppercase text-slate-900 tracking-tight break-words">
            Specific Weather Shield ({cityName})
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Why cheap steel fails in Andhra Pradesh: coastal salt-air and river mists cause immediate pitting and corrosion on ordinary mild steel and cheap SS-202 cables within months.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-2xl mt-0.5">💧</span>
              <div>
                <h3 class="text-sm font-bold text-slate-900 uppercase">The Environmental Challenge</h3>
                <p class="text-xs text-slate-600 mt-1">{location.weatherChallenge}</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-emerald-50/50 border border-emerald-300">
              <span class="text-2xl mt-0.5">🛡️</span>
              <div>
                <h3 class="text-sm font-bold text-[#16A34A] uppercase">The Material: SS-316 & SS-304 Options</h3>
                <p class="text-xs text-slate-700 mt-1">{location.engineeringSolution}</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-300 text-center">
              <span class="text-xl sm:text-2xl font-black text-[#16A34A] block">5 YEARS</span>
              <span class="text-[10px] uppercase tracking-wider text-slate-700 font-semibold block mt-0.5">
                Warranty (Quote Terms)
              </span>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-center">
              <span class="text-xl sm:text-2xl font-black text-slate-900 block">PERIODIC</span>
              <span class="text-[10px] uppercase tracking-wider text-slate-600 font-semibold block mt-0.5">
                Tension Inspection Support
              </span>
            </div>

            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-300 text-center">
              <span class="text-xl sm:text-2xl font-black text-[#16A34A] block">MULTI-STRAND</span>
              <span class="text-[10px] uppercase tracking-wider text-slate-700 font-semibold block mt-0.5">
                Stainless Steel Cable
              </span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-emerald-300 shadow-xl group aspect-[16/10] sm:h-80 w-full">
            <OptimizedGrillImage
              src={heroImage}
              alt={`D-VIEW SS-316 Weather Shield in ${cityName}`}
