---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Website Sitemap | D-VIEW Solutions Invisible Grills"
  description="Explore the complete site map of D-VIEW Solutions. Access all regional service hubs across Andhra Pradesh, architectural solutions, and customer support."
  canonicalUrl="https://dviewsolutions.com/sitemap"
>
  <Navbar client:load />

  <main class="pt-28 pb-20 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 lg:px-10">
      
      {/* Header */}
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-bold text-[#16A34A] uppercase tracking-wider mb-3">
          <span>Navigation Directory</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          WEBSITE <span class="text-[#16A34A]">SITEMAP</span>
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-xl mx-auto">
          Complete structural index of all pages, regional hubs across Andhra Pradesh, and architectural safety services.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm">
        
        {/* Group 1: Core Pages */}
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <h2 class="text-base font-extrabold uppercase tracking-wider text-slate-900 mb-4 pb-2 border-b border-slate-200 flex items-center justify-between">
            <span>Core Navigation</span>
            <span class="text-[#16A34A] text-xs">01</span>
          </h2>
          <ul class="space-y-3">
            <li>
              <a href="/" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Home (Interactive Dashboard)</span>
                <span class="text-slate-400 text-xs">/</span>
              </a>
            </li>
            <li>
              <a href="/about" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>About D-VIEW & Metallurgy</span>
                <span class="text-slate-400 text-xs">/about</span>
              </a>
            </li>
            <li>
              <a href="/solutions" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Architectural Solutions</span>
                <span class="text-slate-400 text-xs">/solutions</span>
              </a>
            </li>
            <li>
              <a href="/projects" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Lifestyle Project Gallery</span>
                <span class="text-slate-400 text-xs">/projects</span>
              </a>
            </li>
            <li>
              <a href="/contact" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Contact & Book Site Visit</span>
                <span class="text-slate-400 text-xs">/contact</span>
              </a>
            </li>
            <li>
              <a href="/privacy" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Legal, Privacy & Cookies</span>
                <span class="text-slate-400 text-xs">/privacy</span>
              </a>
            </li>
          </ul>
        </div>

        {/* Group 2: 7 Regional City Hubs */}
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <h2 class="text-base font-extrabold uppercase tracking-wider text-slate-900 mb-4 pb-2 border-b border-slate-200 flex items-center justify-between">
            <span>7 Andhra Pradesh Regional Hubs</span>
            <span class="text-[#16A34A] text-xs">02</span>
          </h2>
          <ul class="space-y-3">
            <li>
              <a href="/locations" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>All Locations Overview</span>
                <span class="text-slate-400 text-xs">/locations</span>
              </a>
            </li>
            <li>
              <a href="/locations/vizag" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Visakhapatnam (Vizag)</span>
                <span class="text-[#16A34A] text-xs font-bold">Coastal Line SS-316</span>
              </a>
            </li>
            <li>
              <a href="/locations/rajahmundry" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Rajamahendravaram (HQ)</span>
                <span class="text-[#16A34A] text-xs font-bold">Godavari Riverfront</span>
              </a>
            </li>
            <li>
              <a href="/locations/vijayawada" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Vijayawada & Amaravati</span>
                <span class="text-[#16A34A] text-xs font-bold">High-Rise Towers</span>
              </a>
            </li>
            <li>
              <a href="/locations/guntur" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Guntur Hub</span>
                <span class="text-[#16A34A] text-xs font-bold">Urban & Highway</span>
              </a>
            </li>
            <li>
              <a href="/locations/kakinada" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Kakinada Hub</span>
                <span class="text-[#16A34A] text-xs font-bold">Port & Coastal</span>
              </a>
            </li>
            <li>
              <a href="/locations/nellore" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Nellore Hub</span>
                <span class="text-[#16A34A] text-xs font-bold">Penna Riverfront</span>
              </a>
            </li>
            <li>
              <a href="/locations/ongole" class="text-slate-800 font-semibold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Ongole Hub</span>
                <span class="text-[#16A34A] text-xs font-bold">Prakasam Corridor</span>
              </a>
            </li>
          </ul>
        </div>

        {/* Group 3: Architectural Solutions */}
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <h2 class="text-base font-extrabold uppercase tracking-wider text-slate-900 mb-4 pb-2 border-b border-slate-200 flex items-center justify-between">
            <span>Specialized Solutions</span>
            <span class="text-[#16A34A] text-xs">03</span>
          </h2>
          <ul class="space-y-3">
            <li>
              <a href="/solutions" class="text-slate-800 font-semibold hover:text-[#16A34A] transition block">
                SS-316 Balcony Invisible Grills
              </a>
            </li>
            <li>
              <a href="/solutions" class="text-slate-800 font-semibold hover:text-[#16A34A] transition block">
                Window Architectural Safety Cables
              </a>
            </li>
            <li>
              <a href="/solutions" class="text-slate-800 font-semibold hover:text-[#16A34A] transition block">
                Anti-Pigeon & Bird Exclusion Grills
              </a>
            </li>
            <li>
              <a href="/solutions" class="text-slate-800 font-semibold hover:text-[#16A34A] transition block">
                Duplex Staircase & Terrace Railings
              </a>
            </li>
            <li>
              <a href="/about" class="text-slate-800 font-semibold hover:text-[#16A34A] transition block">
                Materials & Approach
              </a>
            </li>
            <li>
              <a href="/contact" class="text-slate-800 font-semibold hover:text-[#16A34A] transition block">
                Ask a Safety Question
              </a>
            </li>
          </ul>
        </div>

        {/* Group 4: Direct Support & Bookings */}
        <div class="p-6 rounded-2xl bg-emerald-50/50 border border-emerald-200">
          <h2 class="text-base font-extrabold uppercase tracking-wider text-slate-900 mb-4 pb-2 border-b border-emerald-200 flex items-center justify-between">
            <span>Direct Concierge</span>
            <span class="text-[#16A34A] text-xs">04</span>
          </h2>
          <ul class="space-y-3">
            <li>
              <a href="tel:+916281620716" class="text-slate-900 font-bold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Direct Phone Call</span>
                <span class="text-emerald-700 font-mono text-xs">+91 62816 20716</span>
              </a>
            </li>
            <li>
              <a href="https://wa.me/916281620716?text=Hello%20D-view%20invisible%20grills%2C%20I%20am%20interested%20in%20invisible%20safety%20grills%20for%20my%20balcony.%20Please%20share%20details." target="_blank" rel="noopener noreferrer" class="text-slate-900 font-bold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>WhatsApp Booking</span>
                <span class="text-[#16A34A] text-xs font-bold">Fastest Response</span>
              </a>
            </li>
            <li>
              <a href="mailto:dviewsolutions32@gmail.com" class="text-slate-900 font-bold hover:text-[#16A34A] transition flex items-center justify-between">
                <span>Official Email Inquiries</span>
                <span class="text-slate-600 text-xs">dviewsolutions32@gmail.com</span>
              </a>
            </li>
            <li>
              <a href="/contact#book-visit" class="text-slate-800 font-semibold hover:text-[#16A34A] transition block">
                Installation Enquiries
              </a>
            </li>
            <li>
              <div class="pt-3 border-t border-emerald-200 text-xs text-slate-600">
                <span class="font-bold text-slate-900 block">Registered Head Office:</span>
                Rajamahendravaram, Andhra Pradesh, India.
              </div>
            </li>
          </ul>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
