---
import Layout from '../../layouts/Layout.astro';
import DViewWebsite from '../../components/DViewWebsite.tsx';
import { ALL_LOCATIONS, type LocationData } from '../../data/locations';

export async function getStaticPaths() {
  const cityAliases: Record<string, string> = {
    'vizag': 'visakhapatnam',
    'visakhapatnam': 'visakhapatnam',
    'rajahmundry': 'rajahmundry',
    'rajamahendravaram': 'rajahmundry',
    'vijayawada': 'vijayawada-amaravati',
    'amaravati': 'vijayawada-amaravati',
    'vijayawada-amaravati': 'vijayawada-amaravati',
    'guntur': 'guntur',
    'kakinada': 'kakinada',
    'nellore': 'nellore',
    'ongole': 'ongole'
  };

  return Object.entries(cityAliases).map(([alias, targetSlug]) => {
    const loc = ALL_LOCATIONS.find(l => l.slug === targetSlug) || ALL_LOCATIONS[0];
    return {
      params: { city: alias },
      props: { location: loc, slug: alias }
    };
  });
}

interface Props {
  location: LocationData;
  slug: string;
}

const { location, slug } = Astro.props;
const primaryCitySlug = location.slug === 'vijayawada-amaravati' ? 'vijayawada' : location.slug;

const CITY_SEO: Record<string, { title: string; description: string; canonical: string }> = {
  visakhapatnam: {
    title: 'SS-316 Invisible Grills in Visakhapatnam | Balcony Safety for Madhurawada, Rushikonda, Yendada | D-View',
    description: 'Engineered stainless steel invisible safety grills in Vizag. Unblocked RK Beach view, 5-year warranty, child & pet fall protection for high-rise balconies. Estimate & site survey coordination.',
    canonical: 'https://www.dviewsolutions.com/safety-pillars/visakhapatnam'
  },
  rajahmundry: {
    title: 'SS-316 Invisible Grills in Rajahmundry | Balcony Safety for Morampudi, Bommuru | D-View',
    description: 'Engineered stainless steel invisible safety grills in Rajamahendravaram. Unblocked Godavari river view, 5-year warranty, pigeon & child protection for riverfront apartments.',
    canonical: 'https://www.dviewsolutions.com/safety-pillars/rajahmundry'
  },
  'vijayawada-amaravati': {
    title: 'SS-316 Invisible Grills in Vijayawada & Amaravati | Balcony Safety for Benz Circle, HappyNest | D-View',
    description: 'Engineered stainless steel invisible safety grills in Vijayawada & Amaravati. Unblocked Krishna river & skyline views, high-rise safety for towers & HappyNest.',
    canonical: 'https://www.dviewsolutions.com/safety-pillars/vijayawada'
  },
  guntur: {
    title: 'SS-316 Invisible Grills in Guntur | Balcony Safety for Brodipet, Arundelpet | D-View',
    description: 'Engineered invisible safety grills in Guntur. Dust-resistant, daylight preserving, toddler fall safety for Brodipet & Amaravati road apartments.',
    canonical: 'https://www.dviewsolutions.com/safety-pillars/guntur'
  },
  kakinada: {
    title: 'SS-316 Marine Grade Invisible Grills in Kakinada | Balcony Safety for Vakalapudi, Sarpavaram | D-View',
    description: 'Engineered stainless steel invisible grills in Kakinada. Coastal corrosion resistance, lighthouse & port view preservation with 5-year warranty.',
    canonical: 'https://www.dviewsolutions.com/safety-pillars/kakinada'
  },
  nellore: {
    title: 'SS-316 Invisible Grills in Nellore | Balcony Safety for Magunta Layout, Balaji Nagar | D-View',
    description: 'Architectural SS-316 invisible safety grills in Nellore. Monsoon-proof anchoring, Penna riverfront sunset preservation, high-floor child & elder protection.',
    canonical: 'https://www.dviewsolutions.com/safety-pillars/nellore'
  },
  ongole: {
    title: 'SS-316 Invisible Grills in Ongole | Balcony Safety for Bhagyanagar, Lawyerpet, Kurnool Road | D-View',
    description: 'Engineered stainless steel invisible safety grills in Ongole. Unblocked Prakasam cityscape view, child & pet fall protection for Bhagyanagar & Lawyerpet high-rises.',
    canonical: 'https://www.dviewsolutions.com/safety-pillars/ongole'
  }
};

const cityMeta = CITY_SEO[location.slug] || CITY_SEO['visakhapatnam'];
// Query parameters (?corridor=...) do not produce independently prerendered Astro static pages;
// consolidate static HTML canonicals to the primary city safety-pillars route.
const canonicalUrl = `https://www.dviewsolutions.com/safety-pillars/${primaryCitySlug}`;
---

<Layout
  title={cityMeta.title}
  description={cityMeta.description}
  canonicalUrl={canonicalUrl}
  cityName={location.name}
  ogImage={location.heroImage}
  preloadHeroImage={location.heroImage}
  keywords={location.keywords}
  faqs={location.faqs || []}
  hideFloatingButtons={true}
>
  <DViewWebsite client:load initialCitySlug={slug} tier="tier3" faqs={location.faqs || []} />
</Layout>
