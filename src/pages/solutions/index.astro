---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import SiteVisitForm from '../../components/SiteVisitForm';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Luxury Invisible Grills & Balcony Safety Solutions | D-VIEW Solutions"
  description="Explore D-VIEW's SS-316 & SS-304 invisible grills: balcony safety grills, window grills, pigeon barrier grills, and high-rise containment solutions."
  canonicalUrl="https://www.dviewsolutions.com/solutions"
>
  <Navbar client:load />

  <main class="pt-28 pb-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-bold text-[#16A34A] uppercase tracking-wider mb-4 shadow-sm">
          <span>Engineered Invisible Grill Collections</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight">
          ARCHITECTURAL INVISIBLE GRILLS <br />
          <span class="text-[#16A34A]">WITHOUT COMPROMISE</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600">
          Architectural grade fall prevention, pet security, and bird defense engineered with premium SS-316 and SS-304 stainless steel.
        </p>
      </div>

    </div>

    <ServicesGrid />
    <PhotoGallery cityName="Andhra Pradesh" />
    <SiteVisitForm client:visible defaultCitySlug="visakhapatnam" cityName="Andhra Pradesh" />
  </main>

  <Footer />
</Layout>
