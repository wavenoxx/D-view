---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import SiteVisitForm from '../components/SiteVisitForm';
import Footer from '../components/Footer.astro';
import { ALL_LOCATIONS } from '../data/locations';
---

<Layout
  title="Contact D-VIEW Solutions | Free Site Measurement Helpline"
  description="Contact D-VIEW Solutions for invisible grill installations in Visakhapatnam, Kakinada, Rajahmundry, Vijayawada, Guntur, Nellore & Ongole. Call +91 62816 20716."
  canonicalUrl="https://www.dviewsolutions.com/contact"
>
  <Navbar client:load />

  <main class="pt-28 pb-16 bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-semibold text-[#16A34A] uppercase tracking-wider mb-4">
          <span>Get in Touch</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          CONNECT WITH <span class="text-[#16A34A]">D-VIEW SOLUTIONS</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600">
          Have questions or ready to schedule your free laser measurement? Our technical coordinators are available 7 days a week.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center shadow-sm hover:shadow-md transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#16A34A] mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-1">Central Helpline</h3>
          <p class="text-xs text-slate-500 mb-3">Direct call with our technical coordinators</p>
          <a href="tel:+916281620716" class="text-base font-extrabold text-[#16A34A] hover:underline">
            +91 62816 20716
          </a>
        </div>

        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center shadow-sm hover:shadow-md transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#16A34A] mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-1">WhatsApp Chat</h3>
          <p class="text-xs text-slate-500 mb-3">Send photos/dimensions for instant review</p>
          <a href="https://wa.me/916281620716?text=Hello%20D-view%20invisible%20grills%2C%20I%20am%20interested%20in%20invisible%20safety%20grills%20for%20my%20balcony.%20Please%20share%20details." target="_blank" rel="noopener noreferrer" class="text-base font-extrabold text-[#16A34A] hover:underline">
            +91 62816 20716
          </a>
        </div>

        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center shadow-sm hover:shadow-md transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#16A34A] mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-1">Email Inquiries</h3>
          <p class="text-xs text-slate-500 mb-3">Architectural blueprints & builder estimates</p>
          <a href="mailto:dviewsolutions32@gmail.com" class="text-base font-extrabold text-slate-800 hover:text-[#16A34A] hover:underline">
            dviewsolutions32@gmail.com
          </a>
        </div>

      </div>

    </div>

    <SiteVisitForm client:load defaultCitySlug="rajahmundry" cityName="Andhra Pradesh" />
  </main>

  <Footer />
</Layout>
