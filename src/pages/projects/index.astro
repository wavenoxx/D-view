---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { ALL_LOCATIONS } from '../../data/locations';

const allProjects = ALL_LOCATIONS.flatMap((loc) => 
  loc.projects.map((p) => ({ ...p, cityName: loc.name, citySlug: loc.slug }))
);
---

<Layout
  title="Recent Projects | D-VIEW Invisible Grills Andhra Pradesh"
  description="Browse recent balcony safety and invisible grill installations across Visakhapatnam, Rajahmundry, Vijayawada, Kakinada, Guntur & Nellore."
  canonicalUrl="https://dviewsolutions.com/projects"
>
  <Navbar client:load />

  <main class="pt-28 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-semibold text-[#16A34A] uppercase tracking-wider mb-4">
          <span>Field Portfolio</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight">
          RECENT RESIDENTIAL <br />
          <span class="text-[#16A34A]">INSTALLATIONS</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600">
          Explore real balconies and penthouses safeguarded with D-VIEW SS-316 invisible grills across Andhra Pradesh.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allProjects.map((project) => (
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-emerald-500 hover:shadow-xl transition-all group flex flex-col justify-between shadow-sm">
            <div>
              <div class="relative h-60 overflow-hidden bg-slate-100">
                <img 
                  src={project.image} 
                  alt={`${project.title} - ${project.locality}`} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-md border border-slate-200 text-[11px] font-bold text-[#16A34A] shadow-sm">
                  {project.cityName} • {project.wireSpec}
                </div>
              </div>

              <div class="p-6">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="text-lg font-black text-slate-900 group-hover:text-[#16A34A] transition-colors">
                    {project.title}
                  </h3>
                  <span class="text-xs font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                    {project.areaSqFt} sq.ft
                  </span>
                </div>

                <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-3">
                  <span>{project.locality}</span>
                  <span>•</span>
                  <span>{project.propertyType}</span>
                </div>

                <p class="text-xs text-slate-600 leading-relaxed">
                  {project.highlight}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6">
              <a
                href={`/contact?city=${encodeURIComponent(project.citySlug)}#book-visit`}
                class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-bold text-slate-950 bg-[#7CFF3A] hover:bg-[#68e028] transition-colors shadow-sm"
              >
                <span>Book Similar in {project.cityName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>
